{
  "name": "backend-testing-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm start",
    "start": "vite",
    "start:select": "tsx scripts/dev.ts",
    "start:beta": "vite --mode beta",
    "build:select": "tsx scripts/build.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check:ts": "tsc --noEmit",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "check": "pnpm check:ts && pnpm check:svelte"
  },
  "devDependencies": {
    "@andypf/json-viewer": "^2.1.5",
    "@eslint/js": "^9.13.0",
    "@inquirer/prompts": "^5.5.0",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^20.17.1",
    "@types/toastify-js": "^1.12.3",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "daisyui": "^4.12.13",
    "eslint": "^9.13.0",
    "eslint-plugin-svelte": "^2.46.0",
    "fuse.js": "^7.0.0",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "svelte": "^5.1.13",
    "svelte-check": "^4.0.5",
    "svelte-eslint-parser": "^0.43.0",
    "svelte-icons-pack": "^3.1.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "toastify-js": "^1.12.0",
    "tslib": "^2.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^7.18.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "ts-node": {
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "esm": true
  }
}
